# Store actual values only on your private server. Never commit .env.
GITHUB_TOKEN=
LIBRARY_UPLOAD_KEY=

# Existing book-source folder; adjust these server-side if your real subrepo differs.
GITHUB_OWNER=StellaWQL
GITHUB_REPO=recipes-widget
GITHUB_BRANCH=practice
GITHUB_BOOKS_PATH=data/books

# Exact browser origins, comma separated. No wildcard and no pathname.
ALLOWED_ORIGINS=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
MAX_BYTES=26214400

# Optional. Leave empty to run API only. Relative paths resolve from your cwd.
# From library-sync-server, STATIC_ROOT=.. serves the existing project as well.
STATIC_ROOT=
